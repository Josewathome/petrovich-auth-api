MODE=prod
SERVICE_NAME=petrovich_auth_api
VERSION_NO=v1.0.0
VERSION_NO_VALUE=v1
BASE_URL=http://localhost:8000
# Request timeouts
FRONTEND_TIMEOUT=15
SESSION_TIMEOUT=15
SEARCH_TIMEOUT=8
# common controller validator
VALIDATOR_URL=http://validator-service/api/v1/validate
VALIDATOR_TIMEOUT=30
VALIDATOR_MAX_RETRIES=2
# Session configuration
MAX_SESSION_RETRIES=2
REQUEST_DELAY=2.0